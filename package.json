{
  "name": "palantree",
  "version": "0.3.4",
  "description": "shadcn/ui design token linting for React, JavaScript, TypeScript and CSS",
  "license": "UNLICENSED",
  "keywords": ["react", "design-system", "design-tokens", "lint", "figma"],
  "publishConfig": { "access": "public" },
  "bugs": {
    "url": "https://github.com/educentenaro/palantree/issues"
  },
  "engines": { "node": ">=22" },
  "files": ["dist"],
  "type": "module",
  "bin": {
    "palantree": "dist/cli.js"
  },
  "scripts": {
    "test": "npm run build && node --test tests/unit/*.test.js tests/integration/*.test.js tests/e2e/*.test.js",
    "test:package": "node scripts/test-package.mjs",
    "check": "tsc --noEmit",
    "build": "tsc",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.26.10",
    "@babel/traverse": "^7.26.10",
    "css-tree": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
